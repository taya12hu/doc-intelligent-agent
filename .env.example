# ──────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. `.env` is gitignored.
# The API validates all of this at boot (apps/api/src/env.ts) and exits
# with a readable message rather than failing halfway through a request.
# ──────────────────────────────────────────────────────────────────────

# ── Gemini ────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey  (free tier is enough
# for this project: 4 documents x 3 samples).
GEMINI_API_KEY=

# Primary extraction model.
#
# RUN `npm run check:models` BEFORE ANYTHING ELSE. It calls each model for
# real rather than checking a list, because being listed does not mean being
# callable: on a free-tier key, gemini-2.5-pro returns 404 ("no longer
# available to new users") and gemini-3.7-flash is frequently 503 overloaded,
# yet both appear in listModels().
#
# Flash models are the dependable free-tier choice. Pro-class models are
# generally quota-blocked (429) until billing is enabled.
GEMINI_MODEL=gemini-3.6-flash

# Escalation model: ONE retry when the repair loop fired. See ARCHITECTURE §5.7.
#
# Ideally a stronger model. On the free tier that is not available, so this is
# a DIFFERENT flash generation instead -- still a different model with
# different failure modes, which is most of the value. With billing enabled,
# point this at a pro model.
GEMINI_ESCALATION_MODEL=gemini-3.5-flash

# Self-consistency: how many independent extraction passes to run and vote
# across. 3 = the design (ARCHITECTURE §5.6).
#
# The free tier allows 5 requests/minute/model, so 3 passes is close to the
# ceiling and a document that needs repair calls WILL hit it. Passes run
# sequentially and the provider honours Gemini's own retry-after hint, so a
# rate limit costs time rather than the extraction -- but set this to 1 while
# developing if you are iterating, and back to 3 for the final run.
EXTRACTION_SAMPLES=3

# ── Supabase ──────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# SERVICE ROLE key - server-side only, never ship this to the browser.
# Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket for raw uploads. Create it as PRIVATE.
SUPABASE_BUCKET=invoices

# Postgres connection string.
# Settings -> Database -> Connection string -> URI
#   Use the SESSION pooler (:5432) - this is a long-running Express server.
#   If you use the TRANSACTION pooler (:6543), the client sets prepare:false
#   automatically (see apps/api/src/db/client.ts) or prepared statements break.
DATABASE_URL=

# ── Server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Where the browser reaches the API (used by the web app at build time).
VITE_API_URL=http://localhost:4000
